`timescale 1ns/1ps
module ALU (
    input  [7:0] A, B,          // 8-bit inputs
    input  [3:0] ALU_Sel,       // 4-bit operation select
    output reg [7:0] ALU_Out    // 8-bit output
);

always @(*) begin
    case (ALU_Sel)
        // Arithmetic
        4'b0000: ALU_Out = A + B;                        // Addition
        4'b0001: ALU_Out = A - B;                        // Subtraction
        4'b0010: ALU_Out = A * B;                        // Multiplication
        4'b0011: ALU_Out = (B != 0) ? (A / B) : 8'b0;    // Division

        // Shifts
        4'b0100: ALU_Out = A << 1;                       // Shift Left
        4'b0101: ALU_Out = A >> 1;                       // Shift Right

        // Rotates (for full 8-bit inputs)
        4'b0110: ALU_Out = {A[6:0], A[7]};               // Rotate Left
        4'b0111: ALU_Out = {A[0], A[7:1]};               // Rotate Right

        // Logical
        4'b1000: ALU_Out = A & B;                        // AND
        4'b1001: ALU_Out = A | B;                        // OR
        4'b1010: ALU_Out = A ^ B;                        // XOR
        4'b1011: ALU_Out = ~(A | B);                     // NOR
        4'b1100: ALU_Out = ~(A & B);                     // NAND
        4'b1101: ALU_Out = ~(A ^ B);                     // XNOR

        // Comparisons
        4'b1110: ALU_Out = (A > B) ? 8'd1 : 8'd0;        // Greater than
        4'b1111: ALU_Out = (A == B) ? 8'd1 : 8'd0;       // Equal

        // Default
        default: ALU_Out = 8'b00000000;
    endcase
end

endmodule
